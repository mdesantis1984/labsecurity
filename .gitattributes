* text=auto

# Consistent source and configuration files
*.py text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.cs text eol=lf
*.bicep text eol=lf
Dockerfile text eol=lf
bin/labsec text eol=lf
bin/scan text eol=lf

# Do not attempt text normalization for binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
